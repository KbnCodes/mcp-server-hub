# --- Required -------------------------------------------------------------

# Bearer token protecting /mcp/* and /api/*. Generate a strong one:
#   openssl rand -hex 32
# On Railway templates this defaults to ${{secret(32)}} (auto-generated).
AUTH_TOKEN=change-me-to-a-long-random-string

# --- Optional -------------------------------------------------------------

# Which servers to enable: comma-separated ids or "all" (default).
# Available: utils, fetch, memory, github, postgres
ENABLED_SERVERS=all

# Enables the `github` server when set (classic or fine-grained PAT).
# GITHUB_TOKEN=

# Enables the `postgres` server when set (read-only SQL access).
# On Railway, reference a database service: ${{Postgres.DATABASE_URL}}
# DATABASE_URL=

# Persist the memory server across restarts. Mount a Railway volume at /data.
# MEMORY_FILE=/data/memory.json

# Max bytes fetched per request by the fetch server (default 1000000).
# FETCH_MAX_BYTES=1000000

# Reject requests whose Mcp-Method header mismatches the JSON-RPC body
# (2026-07-28 spec behavior). Default false = log a warning only.
# STRICT_HEADER_VALIDATION=false

# Requests per minute per IP on /mcp/* and /api/* (default 120). 429 beyond.
# RATE_LIMIT_RPM=120

# Max JSON request body size in bytes (default 1000000).
# MAX_BODY_BYTES=1000000

# The hub refuses to start without AUTH_TOKEN. Set to true to explicitly run
# WITHOUT authentication (NOT recommended — anyone can use your tools).
# ALLOW_NO_AUTH=false

# Canonical public URL (scheme://host) used in the WWW-Authenticate challenge
# and RFC 9728 metadata. If unset, derived from the request Host header.
# PUBLIC_URL=https://your-app.up.railway.app

# Log one structured JSON line per MCP request (ip, server, method, tool, status).
# AUDIT_LOG=false

# Restrict the fetch server to specific hostnames (comma-separated). When
# unset, all public hosts are allowed (private/internal IPs always blocked).
# FETCH_ALLOW_HOSTS=api.example.com,docs.example.com

# Port to listen on. Railway injects this automatically.
# PORT=8080
