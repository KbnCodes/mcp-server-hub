{
  "name": "@kbncodes/mcp-server-hub",
  "version": "1.0.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Production-ready MCP Server Hub — host multiple Model Context Protocol servers behind one authenticated gateway. Stateless Streamable HTTP, 2026-07-28 spec-ready.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-server-hub": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-hub",
    "streamable-http",
    "railway",
    "ai-agents"
  ],
  "license": "MIT",
  "author": "KbnCodes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KbnCodes/mcp-server-hub.git"
  },
  "homepage": "https://github.com/KbnCodes/mcp-server-hub#readme",
  "bugs": {
    "url": "https://github.com/KbnCodes/mcp-server-hub/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
